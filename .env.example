# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Xiaohongshu cookies (from browser login session)
XHS_COOKIE=your_cookie_string_here

# Database
DATABASE_PATH=data/findit.db

# Crawl settings
CRAWL_CITY=深圳
CRAWL_INTERVAL_HOURS=24
CRAWL_REQUEST_DELAY_MIN=2.0
CRAWL_REQUEST_DELAY_MAX=5.0

# Recommendation settings
DAILY_MATCH_COUNT=5
HIGH_MATCH_COUNT=3
PUSH_HOUR=20
PUSH_MINUTE=0
